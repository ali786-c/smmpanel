<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Route API requests to Laravel's public entry point
    # We use QSA to append query strings and ensure the path is handled correctly.
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

    # 2. Serve static files or directories if they exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route everything else to React index.html for CSR (Client Side Routing)
    # Exclude API and Mailer folder explicitly
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^/migration-mailer/
    RewriteRule ^ index.html [L]
</IfModule>
